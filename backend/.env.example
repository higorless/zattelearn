NODE_ENV=production
PORT=3001

# Opção 1 — URL completa (Coolify fornece isso)
DATABASE_URL=postgresql://postgres:senha@hostname:5432/postgres

# Opção 2 — vars individuais (dev local)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=zettelearn
# DB_USER=zettelearn
# DB_PASSWORD=zettelearn

JWT_SECRET=change-me-to-a-long-random-string-minimum-32-chars
